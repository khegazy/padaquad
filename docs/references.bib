@article{berrut2004,
  author  = {Berrut, Jean-Paul and Trefethen, Lloyd N.},
  title   = {Barycentric {L}agrange Interpolation},
  journal = {SIAM Review},
  volume  = {46},
  number  = {3},
  pages   = {501--517},
  year    = {2004},
  doi     = {10.1137/S0036144502417715},
  checked = {PDF opened 2026-11-14 (author copy, people.maths.ox.ac.uk/trefethen/barycentric.pdf) by the adversarial review of the merge-rule plan (PR #69); equation numbers re-checked in its saved text. Eq. (3.2): weights w_j = 1/prod_{k != j}(x_j - x_k). Eq. (4.2): the second (true) barycentric formula p(x) = sum_j w_j f_j/(x - x_j) / sum_j w_j/(x - x_j), with w still defined by (3.2); a common factor of the weights cancels. Eq. (4.1) is only the identity 1 = l(x) sum_j w_j/(x - x_j). Sec. 5: equispaced weights grow like 2^n (ill-conditioned); nodes clustered toward the ends keep them of comparable size.}
}

